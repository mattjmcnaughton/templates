# Check formatting
fmt:
    pnpm run fmt

# Fix formatting
fmt-fix:
    pnpm run fmt-fix

# Check linting
lint:
    pnpm run lint

# Fix linting
lint-fix:
    pnpm run lint-fix

# Run type checker
typecheck:
    pnpm run typecheck

# Run all tests
test-all: test-unit test-integration test-e2e

# Run unit tests
test-unit:
    pnpm run test

# Run integration tests
test-integration:
    pnpm run test-integration

# Run e2e tests
test-e2e:
    pnpm run test-e2e

# Run tests that hit external services
test-external:
    pnpm run test-external

# Fast pre-push check
gate: fmt lint typecheck test-unit

# Full check
gate-expensive: gate test-integration test-e2e

# Everything including external
gate-external: gate-expensive test-external

# Install dependencies and prepare the project for development
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    pnpm install
    if [ -f prisma/schema.prisma ]; then
        pnpm exec prisma generate
    fi

# Start dev server
dev:
    pnpm run dev
