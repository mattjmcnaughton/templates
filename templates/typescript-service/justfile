# Check formatting
fmt:
    bun run fmt

# Fix formatting
fmt-fix:
    bun run fmt-fix

# Check linting
lint:
    bun run lint

# Fix linting
lint-fix:
    bun run lint-fix

# Run type checker
typecheck:
    bun run typecheck

# Run all tests
test-all: test-unit test-integration test-e2e

# Run unit tests
test-unit:
    bun run test

# Run integration tests
test-integration:
    bun run test-integration

# Run e2e tests
test-e2e:
    bun run test-e2e

# Run tests that hit external services
test-external:
    bun run test-external

# Fast pre-push check
gate: fmt lint typecheck test-unit

# Full check
gate-expensive: gate test-integration test-e2e

# Everything including external
gate-external: gate-expensive test-external

# Install dependencies and prepare the project for development
bootstrap:
    bun install

# Start dev server
dev:
    bun run dev
