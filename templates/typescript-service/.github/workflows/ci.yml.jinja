name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  gate-expensive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

      - name: Install just
        run: sudo apt-get update && sudo apt-get install -y just

      - name: Bootstrap
        run: just bootstrap

      - name: Run gate-expensive
        run: just gate-expensive
