"""Example agent demonstrating the agent pattern."""
{% if agent_framework == "pydantic-ai" %}
from dataclasses import dataclass
from functools import cache

from pydantic_ai import Agent


@dataclass
class AgentDeps:
    """Dependencies injected into the agent at runtime."""


@cache
def get_agent() -> Agent[AgentDeps, str]:
    """Build the agent lazily.

    pydantic-ai resolves the provider (and therefore requires OPENAI_API_KEY)
    when the Agent is constructed, so building it at import time would break
    every entry point -- including ``--help``.
    """
    return Agent(
        "openai:gpt-4o",
        deps_type=AgentDeps,
        system_prompt="You are a helpful assistant.",
    )


async def run_agent(prompt: str) -> str:
    """Run the example agent with the given prompt."""
    result = await get_agent().run(prompt, deps=AgentDeps())
    return result.output
{% elif agent_framework == "claude-agent-sdk" %}
from claude_agent_sdk import ClaudeAgentOptions, ResultMessage, query


async def run_agent(prompt: str) -> str:
    """Run the example agent with the given prompt."""
    parts: list[str] = []
    async for message in query(prompt=prompt, options=ClaudeAgentOptions(max_turns=3)):
        if isinstance(message, ResultMessage) and message.result:
            parts.append(message.result)
    return "\n".join(parts)
{% elif agent_framework == "langchain" %}
from langchain.chat_models import init_chat_model
from langchain_core.messages import HumanMessage


async def run_agent(prompt: str) -> str:
    """Run the example agent with the given prompt."""
    model = init_chat_model("gpt-4o", model_provider="openai")
    response = await model.ainvoke([HumanMessage(content=prompt)])
    return str(response.content)
{% endif %}