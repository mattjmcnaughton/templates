name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  gate-expensive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4

      - name: Set up Python
        run: uv python install 3.12
{%- if execution_model == "web" %}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: lts/*

      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: latest
{%- endif %}

      - name: Install just
        run: sudo apt-get update && sudo apt-get install -y just

      - name: Bootstrap
        run: just bootstrap
{%- if execution_model == "web" %}
      # The frontend is scaffolded separately into web/frontend/ from the
      # frontend-react template, so it may not exist yet. `just bootstrap-fe`
      # and the -fe gate targets both skip when it is absent.
      - name: Install Playwright browsers
        run: |
          if [ -f "src/{{ package_name }}/web/frontend/package.json" ]; then
            cd "src/{{ package_name }}/web/frontend"
            pnpm exec playwright install --with-deps
          else
            echo "No frontend scaffolded yet; skipping."
          fi
{%- endif %}

      - name: Run gate-expensive
        run: just gate-expensive
