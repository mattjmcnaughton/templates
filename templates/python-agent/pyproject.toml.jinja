[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">=3.12"
{% if license == "MIT" -%}
license = "MIT"
{% elif license == "Apache-2.0" -%}
license = "Apache-2.0"
{% elif license == "Proprietary" -%}
license = { text = "Proprietary" }
{% endif -%}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
dependencies = [
    "structlog>=24.0",
    "pydantic-settings>=2.0",
{%- if execution_model == "cli" %}
    "typer>=0.9",
{%- else %}
    "fastapi>=0.115",
    "uvicorn[standard]>=0.34",
{%- if enable_otel %}
    "opentelemetry-api>=1.20",
    "opentelemetry-sdk>=1.20",
    "opentelemetry-instrumentation-fastapi>=0.44b0",
    "opentelemetry-exporter-otlp>=1.20",
{%- endif %}
{%- endif %}
{%- if agent_framework == "pydantic-ai" %}
    "pydantic-ai>=0.1",
{%- elif agent_framework == "claude-agent-sdk" %}
    "claude-code-sdk>=0.1",
{%- elif agent_framework == "langchain" %}
    "langchain>=0.3",
    "langchain-core>=0.3",
{%- endif %}
{%- if include_database %}
    "sqlalchemy[asyncio]>=2.0",
    "alembic>=1.13",
{%- if database_type == "postgres" %}
    "asyncpg>=0.29",
{%- elif database_type == "sqlite" %}
    "aiosqlite>=0.20",
{%- endif %}
{%- if execution_model != "cli" and enable_otel %}
    "opentelemetry-instrumentation-sqlalchemy>=0.44b0",
{%- endif %}
{%- endif %}
]
{%- if execution_model == "cli" %}
[project.scripts]
{{ project_name }} = "{{ package_name }}.cli:app"
{% endif %}
[project.urls]
Repository = "https://github.com/{{ author_name | lower | replace(' ', '-') }}/{{ project_name }}"

[tool.uv]
# Supply-chain hardening: refuse to resolve any distribution published less than
# seven days before this project was scaffolded. uv requires a concrete RFC 3339
# timestamp here -- relative values such as "1 week" are silently dropped (older
# uv versions fail to parse the whole [tool.uv] table), which leaves resolution
# completely unpinned while looking pinned. The cutoff below is stamped at
# scaffold time; bump it deliberately when you want newer dependencies.
exclude-newer = "@MIN_RELEASE_AGE_CUTOFF@"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.8",
    "ty>=0.12",
]

[tool.ruff]
target-version = "py312"
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "A", "SIM", "TCH"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
    "external: tests that hit external services",
]
