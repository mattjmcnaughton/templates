# Check formatting
fmt:
    pnpm run fmt

# Fix formatting
fmt-fix:
    pnpm run fmt-fix

# Check linting
lint:
    pnpm run lint

# Fix linting
lint-fix:
    pnpm run lint-fix

# Run type checker
typecheck:
    pnpm run typecheck

# Run all tests
test-all: test-unit test-integration test-e2e

# Run unit tests (co-located in src/)
test-unit:
    pnpm run test

# Run integration tests
test-integration:
    pnpm run test-integration

# Run e2e tests
test-e2e:
    pnpm run test-e2e

# Run tests that hit external services
test-external:
    pnpm exec vitest run -t external --passWithNoTests

# Fast pre-push check
gate: fmt lint typecheck test-unit

# Full check
gate-expensive: gate test-integration test-e2e

# Everything including external
gate-external: gate-expensive test-external

# Install dependencies and prepare the project for development
bootstrap:
    pnpm install
    pnpm run routes

# Start dev server
dev:
    pnpm run dev
