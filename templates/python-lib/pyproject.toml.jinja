[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">=3.12"
{% if license == "MIT" -%}
license = "MIT"
{% elif license == "Apache-2.0" -%}
license = "Apache-2.0"
{% elif license == "Proprietary" -%}
license = { text = "Proprietary" }
{% endif -%}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
dependencies = []

[project.urls]
Repository = "https://github.com/{{ author_name | lower | replace(' ', '-') }}/{{ project_name }}"

[tool.uv]
# Supply-chain hardening: refuse to resolve any distribution published less than
# seven days before this project was scaffolded. uv requires a concrete RFC 3339
# timestamp here -- relative values such as "1 week" are silently dropped (older
# uv versions fail to parse the whole [tool.uv] table), which leaves resolution
# completely unpinned while looking pinned. The cutoff below is stamped at
# scaffold time; bump it deliberately when you want newer dependencies.
exclude-newer = "@MIN_RELEASE_AGE_CUTOFF@"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.8",
    "ty>=0.12",
]

[tool.ruff]
target-version = "py312"
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "A", "SIM", "TCH"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
    "external: tests that hit external services",
]
