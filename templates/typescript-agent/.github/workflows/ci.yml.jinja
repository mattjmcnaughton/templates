name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  gate-expensive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{%- if execution_model == "web" %}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: lts/*

      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: latest
{%- else %}
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2
{%- endif %}

      - name: Install just
        run: sudo apt-get update && sudo apt-get install -y just

      - name: Bootstrap
        run: just bootstrap
{%- if execution_model == "web" %}
      - name: Install Playwright browsers
        run: pnpm exec playwright install --with-deps
{%- endif %}

      - name: Run gate-expensive
        run: just gate-expensive
