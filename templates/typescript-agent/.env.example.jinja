LOG_LEVEL=info
{%- if agent_framework == "claude-agent-sdk" %}
ANTHROPIC_API_KEY=
{%- elif agent_framework == "pi-ai" %}
OPENAI_API_KEY=
{%- elif agent_framework == "langchain-js" %}
OPENAI_API_KEY=
{%- endif %}
{%- if execution_model != "cli" %}
HOST=0.0.0.0
PORT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
{%- endif %}
{%- if include_database %}
{%- if database_type == "postgres" %}
DATABASE_URL=postgresql://localhost:5432/{{ project_name }}
{%- else %}
DATABASE_URL=file:./{{ project_name }}.db
{%- endif %}
{%- endif %}
