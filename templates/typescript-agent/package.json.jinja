{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "description": "{{ project_description }}",
{%- if execution_model == "web" %}
  "private": true,
{%- endif %}
  "type": "module",
{%- if execution_model == "cli" %}
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "{{ project_name }}": "dist/index.js"
  },
  "files": ["dist"],
{%- elif execution_model == "service" %}
  "main": "src/index.ts",
{%- endif %}
  "scripts": {
{%- if execution_model == "cli" %}
    "build": "tsc",
    "prepublishOnly": "tsc",
{%- elif execution_model == "service" %}
    "dev": "bun --watch src/index.ts",
{%- elif execution_model == "web" %}
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
{%- endif %}
{%- if execution_model == "web" %}
    "fmt": "biome format .",
    "fmt-fix": "biome format --write .",
    "lint": "biome lint .",
    "lint-fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "test-integration": "vitest run tests/integration --passWithNoTests",
    "test-e2e": "playwright test --pass-with-no-tests",
    "test-external": "vitest run -t external --passWithNoTests"
{%- else %}
    "fmt": "biome format .",
    "fmt-fix": "biome format --write .",
    "lint": "biome lint .",
    "lint-fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test-integration": "bun test tests/integration",
    "test-e2e": "bun test tests/e2e",
    "test-external": "bun test --test-name-pattern external"
{%- endif %}
  },
  "author": "{{ author_name }} <{{ author_email }}>",
  "license": "{{ license }}",
  "dependencies": {
    "pino": "^9.6",
    "zod": "^3.24"
{%- if execution_model == "cli" %},
    "pino-pretty": "^13.0",
    "commander": "^13.0",
    "chalk": "^5.4"
{%- elif execution_model == "service" %},
    "pino-pretty": "^13.0",
    "hono": "^4.7",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/sdk-node": "^0.57",
    "@opentelemetry/auto-instrumentations-node": "^0.56",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57"
{%- elif execution_model == "web" %},
    "next": "^15.0",
    "react": "^19.0",
    "react-dom": "^19.0",
    "tailwindcss": "^3.4",
    "postcss": "^8.4",
    "autoprefixer": "^10.4",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/sdk-node": "^0.57",
    "@opentelemetry/auto-instrumentations-node": "^0.56",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57"
{%- endif %}
{%- if agent_framework == "claude-agent-sdk" %},
    "@anthropic-ai/claude-agent-sdk": "^0.3"
{%- elif agent_framework == "pi-ai" %},
    "@mariozechner/pi-ai": "^0.73",
    "@mariozechner/pi-agent-core": "^0.73"
{%- elif agent_framework == "langchain-js" %},
    "@langchain/core": "^1.2",
    "@langchain/openai": "^1.5",
    "langchain": "^1.5"
{%- endif %}
{%- if include_database %},
    "@prisma/client": "^6.0"
{%- endif %}
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "typescript": "^5.7"
{%- if execution_model == "web" %},
    "@types/node": "^22.0",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "vitest": "^3.0",
    "@vitejs/plugin-react": "^4.3",
    "@testing-library/react": "^16.0",
    "@testing-library/jest-dom": "^6.6",
    "jsdom": "^26.0",
    "@playwright/test": "^1.49"
{%- else %},
    "@types/bun": "^1.2"
{%- endif %}
{%- if include_database %},
    "prisma": "^6.0"
{%- endif %}
  }
}
