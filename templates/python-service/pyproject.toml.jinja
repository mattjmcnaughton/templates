[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">=3.12"
{% if license == "MIT" -%}
license = "MIT"
{% elif license == "Apache-2.0" -%}
license = "Apache-2.0"
{% elif license == "Proprietary" -%}
license = { text = "Proprietary" }
{% endif -%}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.34",
    "structlog>=24.0",
    "pydantic-settings>=2.0",
    "opentelemetry-api>=1.20",
    "opentelemetry-sdk>=1.20",
    "opentelemetry-instrumentation-fastapi>=0.44b0",
    "opentelemetry-exporter-otlp>=1.20",
{%- if include_database %}
    "sqlalchemy[asyncio]>=2.0",
    "alembic>=1.13",
{%- if database_type == "postgres" %}
    "asyncpg>=0.29",
    "opentelemetry-instrumentation-sqlalchemy>=0.44b0",
{%- elif database_type == "sqlite" %}
    "aiosqlite>=0.20",
    "opentelemetry-instrumentation-sqlalchemy>=0.44b0",
{%- endif %}
{%- endif %}
]

[project.urls]
Repository = "https://github.com/{{ author_name | lower | replace(' ', '-') }}/{{ project_name }}"

[tool.uv]
exclude-newer = "1 week"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.8",
    "ty>=0.12",
]

[tool.ruff]
target-version = "py312"
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "A", "SIM", "TCH"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
    "external: tests that hit external services",
]
