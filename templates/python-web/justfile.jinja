fe_dir := "src/{{ package_name }}/web/frontend"

# Run a script from the frontend's package.json.
#
# The frontend is scaffolded separately (see the README in {{ "{{" }}fe_dir{{ "}}" }}), so a
# freshly generated backend has no package.json there yet. Skip cleanly in that
# case rather than failing every -fe target and turning first-commit CI red.
[private]
fe script:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ "{{" }}fe_dir{{ "}}" }}/package.json" ]; then
        echo "no frontend scaffolded in {{ "{{" }}fe_dir{{ "}}" }}/ -- skipping {{ "{{" }}script{{ "}}" }}"
        exit 0
    fi
    cd "{{ "{{" }}fe_dir{{ "}}" }}" && pnpm run "{{ "{{" }}script{{ "}}" }}"

# Check formatting (backend + frontend)
fmt: fmt-be fmt-fe

# Check backend formatting
fmt-be:
    uv run ruff format --check .

# Check frontend formatting
fmt-fe: (fe "fmt")

# Fix formatting (backend + frontend)
fmt-fix: fmt-fix-be fmt-fix-fe

# Fix backend formatting
fmt-fix-be:
    uv run ruff format .

# Fix frontend formatting
fmt-fix-fe: (fe "fmt-fix")

# Check linting (backend + frontend)
lint: lint-be lint-fe

# Check backend linting
lint-be:
    uv run ruff check .

# Check frontend linting
lint-fe: (fe "lint")

# Fix linting (backend + frontend)
lint-fix: lint-fix-be lint-fix-fe

# Fix backend linting
lint-fix-be:
    uv run ruff check --fix .

# Fix frontend linting
lint-fix-fe: (fe "lint-fix")

# Run type checker (backend + frontend)
typecheck: typecheck-be typecheck-fe

# Run backend type checker
typecheck-be:
    uv run ty check

# Run frontend type checker
typecheck-fe: (fe "typecheck")

# Run all tests
test-all: test-unit test-integration test-e2e

# Run unit tests (backend + frontend)
test-unit: test-unit-be test-unit-fe

# Run backend unit tests
test-unit-be:
    uv run pytest tests/unit

# Run frontend unit tests
test-unit-fe: (fe "test")

# Run integration tests
test-integration:
    uv run pytest tests/integration

# Run e2e tests
test-e2e:
    uv run pytest tests/e2e

# Run tests that hit external services
test-external:
    uv run pytest -m external

# Fast pre-push check (backend + frontend)
gate: gate-be gate-fe

# Backend gate
gate-be: fmt-be lint-be typecheck-be test-unit-be

# Frontend gate
gate-fe: fmt-fe lint-fe typecheck-fe test-unit-fe

# Full check
gate-expensive: gate test-integration test-e2e

# Everything including external
gate-external: gate-expensive test-external

# Start backend dev server
dev-be:
    uv run uvicorn {{ package_name }}.app:app --reload

# Start frontend dev server
dev-fe: (fe "dev")

# Start both dev servers
dev:
    #!/usr/bin/env bash
    just dev-be &
    just dev-fe &
    wait
