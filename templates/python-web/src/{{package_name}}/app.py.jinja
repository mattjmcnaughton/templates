"""FastAPI application factory."""

from contextlib import asynccontextmanager

from fastapi import FastAPI

from {{ package_name }}.logging import configure_logging
from {{ package_name }}.routers import health
{%- if enable_otel %}
from {{ package_name }}.telemetry import setup_telemetry
{%- endif %}
from {{ package_name }}.web.serve import mount_frontend


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan handler."""
    configure_logging()
    yield


def create_app() -> FastAPI:
    """Create and configure the FastAPI application."""
    app = FastAPI(
        title="{{ project_name }}",
        description="{{ project_description }}",
        version="0.1.0",
        lifespan=lifespan,
    )
{% if enable_otel %}
    setup_telemetry(app)
{% endif %}
    app.include_router(health.router)

    # Mount frontend static files (only serves if dist/ exists)
    mount_frontend(app)

    return app


app = create_app()
