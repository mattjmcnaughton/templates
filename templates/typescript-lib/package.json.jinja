    "test-integration": "bun test tests/integration",
    "test-e2e": "bun test tests/e2e",
    "test-external": "bun test --test-name-pattern external"
  },
  "author": "{{ author_name }} <{{ author_email }}>",
  "license": "{{ license }}",
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "@types/bun": "^1.2",
    "typescript": "^5.7"
  }
