"""Smoke test for the e2e suite.

Replace this with tests that drive the installed CLI the way a user would.
"""

import subprocess


def test_installed_entry_point_runs() -> None:
    """The console script declared in pyproject.toml is on PATH and runs."""
    result = subprocess.run(
        ["{{ project_name }}", "--help"], capture_output=True, text=True, check=False
    )
    assert result.returncode == 0, result.stderr
    assert result.stdout.strip()
